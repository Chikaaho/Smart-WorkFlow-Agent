{
	"name": "@earendil-works/pi-workflow-agent",
	"version": "1.4.0",
	"description": "Governed desktop workflow orchestration for Pi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"author": "Earendil Works",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"shx": "0.3.4",
		"vitest": "4.1.12"
	}
}
